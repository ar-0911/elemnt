# HTTPS for Elemnt. Caddy asks Elemnt before getting a certificate for a name,
# so it only ever requests certificates for the app, the sandbox and published sites.
{
	on_demand_tls {
		ask http://server:8787/internal/tls-allow
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy server:8787
}

# Plain HTTP redirects to HTTPS.
http:// {
	redir https://{host}{uri} permanent
}
