# Copy to .env. Required:
ELEMNT_SECRET_KEY=            # openssl rand -base64 32  (encrypts LinkedIn tokens and Anthropic API keys)
ELEMNT_PUBLIC_URL=http://localhost:8787
ELEMNT_WORKSPACE=default

# Widgets and runnable code run on a second origin that points at this same server.
# Locally it defaults to 127.0.0.1 when ELEMNT_PUBLIC_URL is localhost (and the reverse).
# In production use a separate registrable domain, e.g. https://acme.elemntusercontent.com
# ELEMNT_SANDBOX_URL=
# Lets workspace admins mark themselves verified (autorun + allowed hosts). SaaS operators set false.
ELEMNT_WIDGET_SELF_VERIFY=true
# Page styles load fonts from Google Fonts; set to "off" to keep every font local.
ELEMNT_FONTS=google

# Blobs (page sources and rendered HTML) go to ELEMNT_BLOB_DIR unless a bucket is set.
# Any S3-compatible store works: AWS S3, Cloudflare R2 (region "auto"), MinIO.
# ELEMNT_S3_BUCKET=
# ELEMNT_S3_ENDPOINT=         # e.g. https://<account-id>.r2.cloudflarestorage.com; omit for AWS
# ELEMNT_S3_REGION=us-east-1
# ELEMNT_S3_ACCESS_KEY_ID=     # omit on AWS to use the container or instance role
# ELEMNT_S3_SECRET_ACCESS_KEY=
# On hosts where you can't run the bootstrap script, the first start creates the
# workspace for this owner and prints their API token once.
# ELEMNT_OWNER_EMAIL=

# Only for `pnpm dev` outside Docker:
# DATABASE_URL=postgres://elemnt:elemnt@localhost:5432/elemnt

# Optional: a server-wide Anthropic API key. Workspaces can set their own in Settings, which wins.
ANTHROPIC_API_KEY=

# GitHub (optional), for repo explainer pages. Read-only. Prefer a GitHub App with
# Contents: read and Metadata: read, subscribed to push events, webhook URL
# $ELEMNT_PUBLIC_URL/integrations/github/webhook. Public repos work with nothing set.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM; write newlines as \n
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=                 # alternative to the App, e.g. a fine-grained read-only token

# LinkedIn (optional). Create an app at https://www.linkedin.com/developers/apps,
# add the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products,
# and set the redirect URL to $ELEMNT_PUBLIC_URL/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509   # YYYYMM; LinkedIn retires versions after about a year
