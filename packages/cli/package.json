{
  "name": "elemnt",
  "version": "0.1.0",
  "description": "Turn a GitHub repo into an interactive Elemnt explainer page: `npx elemnt explain`.",
  "type": "module",
  "bin": { "elemnt": "./dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
